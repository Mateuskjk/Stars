# Copie para .env e preencha. Só o servidor lê este arquivo; o navegador nunca vê esses valores.
# Supabase > Connect > Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
