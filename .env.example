# Copie para .env e preencha. Só o servidor lê este arquivo; o navegador nunca vê esses valores.
# Supabase > Connect > Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Autenticação Google
GOOGLE_CLIENT_ID=

# Banco de Dados (Prisma)
DATABASE_URL=
DIRECT_URL=

# Autenticação JWT
AUTH_SECRET=

# Supabase (storage de arquivos)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# E-mail (notificações)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3 / MinIO (anexos em cards) — se não usar Supabase Storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Entrar com o Google (opcional). Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback  (ex.: http://localhost:4200/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do app (em produção). Sem ele, usa o endereço da própria requisição.
APP_URL=
