# Copie para .env e preencha. Só o servidor lê este arquivo; o navegador nunca vê esses valores.
# Supabase > Connect > Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Certificado do Supabase para conferir o TLS do banco (recomendado em produção).
# Supabase > Database > Settings > SSL Configuration > Download certificate. Cole o conteúdo inteiro (-----BEGIN CERTIFICATE----- ...).
DATABASE_CA=

# Superadmins (e-mails separados por vírgula): só eles alteram os domínios permitidos e os modelos de IA,
# que valem para todas as empresas. Obrigatório em produção para essas telas.
LEXAGILE_SUPERADMINS=

# Banco de Dados (Prisma) — usado pelo outro sistema; o LexÁgile usa só o DATABASE_URL acima
DIRECT_URL=

# Autenticação JWT
AUTH_SECRET=

# Supabase (storage de arquivos)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# E-mail (notificações)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3 / MinIO (anexos em cards) — se não usar Supabase Storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Entrar com o Google (opcional). Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback  (ex.: http://localhost:4200/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do app (em produção). Sem ele, usa o endereço da própria requisição.
APP_URL=

# Chave para cifrar as chaves de API da IA guardadas no banco (obrigatória em produção).
# Gere uma aleatória, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não troque depois de salvar modelos de IA: as chaves já salvas deixariam de abrir (seria preciso salvá-las de novo).
LEXAGILE_SECRET=
